# ── Razorpay (Test Mode) ─────────────────────────────────────────────
# Dashboard → Account & Settings → API Keys → Generate Test Key
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Vision / LLM for bill scanning (optional) ────────────────────────
# If neither is set, the scanner falls back to editable sample
# line items so the demo never breaks.
GEMINI_API_KEY=
# or
OPENAI_API_KEY=

# ── Public base URL used in share links (optional) ───────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
